<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Boldyn Networks — Campus Wi-Fi Registration</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');

    :root {
      --navy:   #0D1B3E;
      --teal:   #00C4B4;
      --teal-d: #009E91;
      --teal-l: #E0FAF8;
      --white:  #FFFFFF;
      --off:    #F5F7FA;
      --muted:  #6B7A99;
      --border: #DDE3EE;
      --error:  #E03B3B;
      --success:#00B89C;
      --text:   #1A2540;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { font-size: 16px; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--navy);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── SIGNAL ANIMATION (signature element) ── */
    .signal-bg {
      position: fixed; inset: 0;
      pointer-events: none;
      overflow: hidden;
      z-index: 0;
    }
    .signal-bg svg {
      position: absolute;
      bottom: -60px; right: -60px;
      opacity: 0.06;
      width: min(700px, 100vw);
    }
    .arc { transform-origin: center; }
    .arc:nth-child(1) { animation: pulse 3s ease-in-out infinite; }
    .arc:nth-child(2) { animation: pulse 3s ease-in-out 0.5s infinite; }
    .arc:nth-child(3) { animation: pulse 3s ease-in-out 1s infinite; }
    .arc:nth-child(4) { animation: pulse 3s ease-in-out 1.5s infinite; }
    @keyframes pulse {
      0%, 100% { opacity: 0.3; }
      50%       { opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
      .arc { animation: none; }
    }

    /* ── HEADER ── */
    header {
      position: relative; z-index: 10;
      background: rgba(13, 27, 62, 0.97);
      border-bottom: 1px solid rgba(0, 196, 180, 0.2);
      padding: 0 clamp(1rem, 5vw, 3rem);
      height: 64px;
      display: flex;
      align-items: center;
      backdrop-filter: blur(8px);
    }
    .logo-wrap {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
    }
    .logo-icon {
      width: 36px; height: 36px;
      flex-shrink: 0;
    }
    .logo-name {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1.25rem;
      color: var(--white);
      letter-spacing: -0.02em;
    }
    .logo-name span { color: var(--teal); }

    /* ── MAIN ── */
    main {
      position: relative; z-index: 10;
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(1.5rem, 5vw, 3rem) clamp(1rem, 4vw, 2rem);
    }

    /* ── CARD ── */
    .card {
      background: var(--white);
      border-radius: 20px;
      width: 100%;
      max-width: 480px;
      box-shadow: 0 24px 80px rgba(0,0,0,0.35), 0 0 0 1px rgba(0,196,180,0.12);
      overflow: hidden;
    }

    .card-hero {
      background: linear-gradient(135deg, var(--navy) 0%, #162B5C 100%);
      padding: 2rem 2rem 1.75rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .card-hero::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--teal), transparent);
    }
    .card-hero .ssid-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(0,196,180,0.15);
      border: 1px solid rgba(0,196,180,0.3);
      border-radius: 100px;
      padding: 0.3rem 0.75rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--teal);
      margin-bottom: 0.85rem;
    }
    .card-hero h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: clamp(1.25rem, 4vw, 1.55rem);
      color: var(--white);
      line-height: 1.25;
      margin-bottom: 0.4rem;
    }
    .card-hero p {
      font-size: 0.85rem;
      color: rgba(255,255,255,0.6);
      line-height: 1.5;
    }

    .card-body {
      padding: clamp(1.5rem, 4vw, 2rem);
    }

    /* ── FORM ── */
    .field {
      margin-bottom: 1.1rem;
    }
    .field label {
      display: block;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.45rem;
    }
    .input-wrap {
      position: relative;
    }
    .input-wrap svg {
      position: absolute;
      left: 0.85rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      pointer-events: none;
      transition: color 0.2s;
      flex-shrink: 0;
    }
    .input-wrap input {
      width: 100%;
      height: 48px;
      padding: 0 0.9rem 0 2.6rem;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
      color: var(--text);
      background: var(--off);
      transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
      outline: none;
      -webkit-appearance: none;
    }
    .input-wrap input::placeholder { color: #A8B4CC; }
    .input-wrap input:focus {
      border-color: var(--teal);
      background: var(--white);
      box-shadow: 0 0 0 3px rgba(0,196,180,0.12);
    }
    .input-wrap input:focus + svg,
    .input-wrap input:focus ~ svg { color: var(--teal); }
    .input-wrap input:focus ~ svg,
    .input-wrap svg { /* re-order: icon before input in DOM but above via abs */ }

    .input-wrap input.invalid {
      border-color: var(--error);
      background: #FFF5F5;
    }
    .field-error {
      font-size: 0.75rem;
      color: var(--error);
      margin-top: 0.3rem;
      display: none;
    }
    .field-error.show { display: block; }

    /* ── REGISTER BUTTON ── */
    .btn-register {
      width: 100%;
      height: 52px;
      margin-top: 0.5rem;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--teal) 0%, var(--teal-d) 100%);
      color: var(--white);
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      letter-spacing: 0.01em;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
      box-shadow: 0 4px 18px rgba(0,196,180,0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }
    .btn-register:disabled {
      opacity: 0.35;
      cursor: not-allowed;
      box-shadow: none;
    }
    .btn-register:not(:disabled):hover {
      opacity: 0.92;
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(0,196,180,0.45);
    }
    .btn-register:not(:disabled):active { transform: translateY(0); }

    .spinner {
      width: 18px; height: 18px;
      border: 2.5px solid rgba(255,255,255,0.35);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      display: none;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .btn-register.loading .spinner { display: block; }
    .btn-register.loading .btn-text { display: none; }

    /* ── FOOTER ── */
    footer {
      position: relative; z-index: 10;
      background: rgba(13,27,62,0.95);
      border-top: 1px solid rgba(255,255,255,0.06);
      padding: 0.85rem clamp(1rem, 5vw, 3rem);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }
    .footer-logo { width: 22px; height: 22px; flex-shrink: 0; }
    footer p {
      font-size: 0.72rem;
      color: rgba(255,255,255,0.4);
    }

    /* ── SUCCESS PAGE ── */
    #page-success { display: none; }
    #page-success .card-hero {
      background: linear-gradient(135deg, #0A2E2A 0%, #0D3B35 100%);
    }
    .success-check {
      width: 56px; height: 56px;
      background: rgba(0,196,180,0.15);
      border: 2px solid var(--teal);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
    }
    .cred-grid {
      display: grid;
      gap: 0.85rem;
    }
    .cred-item {
      background: var(--off);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.75rem 1rem;
    }
    .cred-item .cred-label {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.2rem;
    }
    .cred-item .cred-value {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text);
      word-break: break-all;
    }
    .cred-item.highlight {
      background: var(--teal-l);
      border-color: rgba(0,196,180,0.35);
    }
    .cred-item.highlight .cred-value { color: var(--teal-d); font-size: 1.1rem; letter-spacing: 0.05em; }
    .connect-note {
      margin-top: 1.25rem;
      background: linear-gradient(135deg, var(--navy) 0%, #162B5C 100%);
      border-radius: 12px;
      padding: 1rem 1.1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .connect-note svg { flex-shrink: 0; color: var(--teal); }
    .connect-note p { font-size: 0.82rem; color: rgba(255,255,255,0.8); line-height: 1.5; }
    .connect-note strong { color: var(--teal); }

    /* ── FAILURE PAGE ── */
    #page-failure { display: none; }
    #page-failure .card-hero {
      background: linear-gradient(135deg, #2E0A0A 0%, #3D1010 100%);
    }
    #page-failure .card-hero::after {
      background: linear-gradient(90deg, transparent, var(--error), transparent);
    }
    .error-icon {
      width: 56px; height: 56px;
      background: rgba(224,59,59,0.1);
      border: 2px solid var(--error);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
    }
    .btn-retry {
      width: 100%;
      height: 52px;
      margin-top: 1rem;
      border: 2px solid var(--teal);
      border-radius: 12px;
      background: transparent;
      color: var(--teal);
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
    }
    .btn-retry:hover { background: var(--teal); color: var(--white); }

    /* ── WATCH (very small) ── */
    @media (max-width: 200px) {
      .card { border-radius: 0; }
      .card-hero { padding: 1rem; }
      .card-hero h1 { font-size: 0.9rem; }
      .card-body { padding: 0.75rem; }
      .input-wrap input { height: 36px; font-size: 0.8rem; }
    }

    /* ── TABLET / DESKTOP boosts ── */
    @media (min-width: 600px) {
      .card { max-width: 500px; }
    }
  </style>
</head>
<body>

  <!-- Signature ambient signal animation -->
  <div class="signal-bg" aria-hidden="true">
    <svg viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle class="arc" cx="600" cy="600" r="150" stroke="white" stroke-width="2" fill="none"/>
      <circle class="arc" cx="600" cy="600" r="250" stroke="white" stroke-width="2" fill="none"/>
      <circle class="arc" cx="600" cy="600" r="350" stroke="white" stroke-width="2" fill="none"/>
      <circle class="arc" cx="600" cy="600" r="450" stroke="white" stroke-width="2" fill="none"/>
    </svg>
  </div>

  <!-- HEADER -->
  <header>
    <a href="#" class="logo-wrap" aria-label="Boldyn Networks">
      <svg class="logo-icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="36" height="36" rx="8" fill="#00C4B4"/>
        <path d="M18 26c-2 0-3.8-.7-5.2-1.8L10 27c2 1.7 4.6 2.7 8 2.7s6-1 8-2.7l-2.8-2.8C21.8 25.3 20 26 18 26z" fill="white"/>
        <path d="M18 20a5 5 0 00-3.5 1.5L12 19a8 8 0 0112 0l-2.5 2.5A5 5 0 0018 20z" fill="white" opacity=".85"/>
        <path d="M18 14a11 11 0 00-7.8 3.2L7.5 14.5A15 15 0 0118 10a15 15 0 0110.5 4.5l-2.7 2.7A11 11 0 0018 14z" fill="white" opacity=".55"/>
        <circle cx="18" cy="29" r="2" fill="white"/>
      </svg>
      <span class="logo-name">Bold<span>yn</span></span>
    </a>
  </header>

  <!-- MAIN -->
  <main>

    <!-- ══════════════════ REGISTRATION PAGE ══════════════════ -->
    <div class="card" id="page-register">
      <div class="card-hero">
        <div class="ssid-badge">
          <svg width="10" height="10" viewBox="0 0 12 12" fill="currentColor"><circle cx="6" cy="6" r="6"/></svg>
          Campus Wi-Fi Access
        </div>
        <h1>Connect to your<br>university network</h1>
        <p>Register once and get your personal Wi-Fi password instantly.</p>
      </div>

      <div class="card-body">
        <form id="reg-form" novalidate autocomplete="off">

          <!-- Name -->
          <div class="field">
            <label for="f-name">Full Name</label>
            <div class="input-wrap">
              <input type="text" id="f-name" name="name" placeholder="Jane Smith" autocomplete="name" />
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="field-error" id="err-name">Please enter your full name.</div>
          </div>

          <!-- Email -->
          <div class="field">
            <label for="f-email">University Email</label>
            <div class="input-wrap">
              <input type="email" id="f-email" name="email" placeholder="jane@university.edu" autocomplete="email" />
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
            </div>
            <div class="field-error" id="err-email">Please enter a valid email address.</div>
          </div>

          <!-- Mobile -->
          <div class="field">
            <label for="f-mobile">Mobile Number</label>
            <div class="input-wrap">
              <input type="tel" id="f-mobile" name="mobile" placeholder="+1 555 000 0000" autocomplete="tel" />
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            </div>
            <div class="field-error" id="err-mobile">Please enter a mobile number (digits, spaces, +, - allowed).</div>
          </div>

          <button type="submit" class="btn-register" id="btn-reg" disabled>
            <div class="spinner" aria-hidden="true"></div>
            <span class="btn-text">Register &amp; Get Wi-Fi Password</span>
          </button>

        </form>
      </div>
    </div><!-- /page-register -->


    <!-- ══════════════════ SUCCESS PAGE ══════════════════ -->
    <div class="card" id="page-success">
      <div class="card-hero">
        <div class="success-check" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#00C4B4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h1>You're all set!</h1>
        <p>Your personal Wi-Fi credentials are ready. Connect now.</p>
      </div>

      <div class="card-body">
        <div class="cred-grid">
          <div class="cred-item">
            <div class="cred-label">Name</div>
            <div class="cred-value" id="s-name">—</div>
          </div>
          <div class="cred-item">
            <div class="cred-label">Email</div>
            <div class="cred-value" id="s-email">—</div>
          </div>
          <div class="cred-item">
            <div class="cred-label">Mobile</div>
            <div class="cred-value" id="s-mobile">—</div>
          </div>
          <div class="cred-item highlight">
            <div class="cred-label">Your Wi-Fi Password (PPSK)</div>
            <div class="cred-value" id="s-ppsk">—</div>
          </div>
        </div>

        <div class="connect-note" role="note">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.55a11 11 0 0114.08 0"/><path d="M1.42 9a16 16 0 0121.16 0"/><path d="M8.53 16.11a6 6 0 016.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
          <p>Open Wi-Fi settings and connect to <strong id="s-ssid">—</strong> using the password above.</p>
        </div>
      </div>
    </div><!-- /page-success -->


    <!-- ══════════════════ FAILURE PAGE ══════════════════ -->
    <div class="card" id="page-failure">
      <div class="card-hero">
        <div class="error-icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#E03B3B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </div>
        <h1>We're sorry</h1>
        <p>We couldn't complete your registration right now.</p>
      </div>

      <div class="card-body">
        <p style="font-size:0.9rem;color:var(--muted);line-height:1.6;margin-bottom:0.5rem;">
          Our service is experiencing a temporary issue. Your details have not been saved. Please try again in a moment — if the problem persists, contact your campus IT helpdesk.
        </p>
        <p id="fail-detail" style="font-size:0.78rem;color:var(--error);margin-bottom:0.25rem;word-break:break-all;"></p>
        <button class="btn-retry" onclick="showPage('register')">← Back to Registration</button>
      </div>
    </div><!-- /page-failure -->

  </main>

  <!-- FOOTER -->
  <footer>
    <svg class="footer-logo" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="36" height="36" rx="8" fill="#00C4B4"/>
      <path d="M18 26c-2 0-3.8-.7-5.2-1.8L10 27c2 1.7 4.6 2.7 8 2.7s6-1 8-2.7l-2.8-2.8C21.8 25.3 20 26 18 26z" fill="white"/>
      <path d="M18 20a5 5 0 00-3.5 1.5L12 19a8 8 0 0112 0l-2.5 2.5A5 5 0 0018 20z" fill="white" opacity=".85"/>
      <path d="M18 14a11 11 0 00-7.8 3.2L7.5 14.5A15 15 0 0118 10a15 15 0 0110.5 4.5l-2.7 2.7A11 11 0 0018 14z" fill="white" opacity=".55"/>
      <circle cx="18" cy="29" r="2" fill="white"/>
    </svg>
    <p>&copy; <span id="copy-year"></span> Boldyn Networks. All rights reserved.</p>
  </footer>

  <script>
    // ── No API keys or XIQ constants here — all sensitive calls happen server-side ──

    // Dynamic copyright year
    document.getElementById('copy-year').textContent = new Date().getFullYear();

    // ── Page routing ───────────────────────────────────────────────
    function showPage(name) {
      ['register','success','failure'].forEach(p =>
        document.getElementById('page-' + p).style.display = 'none'
      );
      document.getElementById('page-' + name).style.display = 'block';
      window.scrollTo({top: 0, behavior: 'smooth'});
    }
    showPage('register');

    // ── Form validation ────────────────────────────────────────────
    const nameEl   = document.getElementById('f-name');
    const emailEl  = document.getElementById('f-email');
    const mobileEl = document.getElementById('f-mobile');
    const btnReg   = document.getElementById('btn-reg');

    function isValidEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()); }
    function isValidMobile(v) { return /^[\d\s\+\-\(\)]{7,20}$/.test(v.trim()); }

    function checkForm() {
      const ok = nameEl.value.trim().length >= 2
               && isValidEmail(emailEl.value)
               && isValidMobile(mobileEl.value);
      btnReg.disabled = !ok;
    }

    function showFieldError(id, show) {
      document.getElementById(id).classList.toggle('show', show);
    }

    function validateOnBlur(input, testFn, errId) {
      input.addEventListener('blur', () => {
        const bad = input.value.trim() && !testFn(input.value);
        input.classList.toggle('invalid', bad);
        showFieldError(errId, bad);
      });
      input.addEventListener('input', () => {
        if (input.classList.contains('invalid')) {
          const bad = !testFn(input.value);
          input.classList.toggle('invalid', bad);
          showFieldError(errId, bad);
        }
        checkForm();
      });
    }

    nameEl.addEventListener('input', checkForm);
    validateOnBlur(nameEl,   v => v.trim().length >= 2,  'err-name');
    validateOnBlur(emailEl,  isValidEmail,                'err-email');
    validateOnBlur(mobileEl, isValidMobile,               'err-mobile');

    // ── Registration — single call to our secure backend proxy ─────
    document.getElementById('reg-form').addEventListener('submit', async (e) => {
      e.preventDefault();

      const name   = nameEl.value.trim();
      const email  = emailEl.value.trim();
      const mobile = mobileEl.value.trim();

      if (!name || !isValidEmail(email) || !isValidMobile(mobile)) return;

      btnReg.classList.add('loading');
      btnReg.disabled = true;

      try {
        const res = await fetch('/api/wifi-register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          // Only student-supplied data leaves the browser — no tokens, no policy IDs
          body: JSON.stringify({ name, email, mobile })
        });

        const payload = await res.json();

        if (!res.ok || !payload.success) {
          // Surface server-side validation errors if present
          const msg = payload.errors
            ? payload.errors.join(' ')
            : (payload.error || 'Registration failed.');
          throw new Error(msg);
        }

        const { data } = payload;

        document.getElementById('s-name').textContent   = data.name;
        document.getElementById('s-email').textContent  = data.email;
        document.getElementById('s-mobile').textContent = data.mobile;
        document.getElementById('s-ppsk').textContent   = data.ppsk || '(check your email)';
        document.getElementById('s-ssid').textContent   = data.ssid;

        showPage('success');

      } catch (err) {
        console.error('Registration error:', err);
        document.getElementById('fail-detail').textContent = err.message || '';
        showPage('failure');
      } finally {
        btnReg.classList.remove('loading');
        btnReg.disabled = false;
      }
    });
  </script>
</body>
</html>
